---
// Text entries on the Work pages. `href` and `repo` are optional because not
// every project has a write-up or a public repo.
export interface Project {
  href?: string;
  repo?: string;
  title: string;
  year: string;
  stack: string;
  blurb: string;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

{
  projects.map((p) => (
    <article class="project">
      <div class="project-head">
        <h2>{p.href ? <a href={p.href}>{p.title}</a> : p.title}</h2>
        <span class="meta">{p.year}</span>
      </div>
      <p class="meta stack">{p.stack}</p>
      <p>{p.blurb}</p>
      {(p.href || p.repo) && (
        <p class="links">
          {p.href && <a href={p.href}>Full write-up</a>}
          {p.repo && <a href={p.repo}>GitHub</a>}
        </p>
      )}
    </article>
  ))
}

<style>
  .project {
    border-top: 1px solid var(--grid);
    padding: 1.8rem 0 1.2rem;
    max-width: var(--measure);
  }
  .project-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .project h2 {
    margin: 0;
  }
  .project h2 a {
    text-decoration: none;
  }
  .project h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--c0);
  }
  .stack {
    margin: 0.4rem 0 0.8rem;
  }
  .links {
    display: flex;
    gap: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
</style>
