---
import Base from '../../layouts/Base.astro';
import OrchestrationDiagram from '../../components/OrchestrationDiagram.astro';
import ProjectList, { type Project } from '../../components/ProjectList.astro';
import TrackNav from '../../components/TrackNav.astro';

const projects: Project[] = [
  {
    href: '/projects/metrics-layer/',
    repo: 'https://github.com/shangweiyang79/taiwanplus-dbt',
    title: 'A tested metrics layer for four social platforms',
    year: '2026',
    stack: 'dbt · SQL · BigQuery · Python',
    blurb:
      'Metric definitions conflicted across platforms, and two "views" numbers sat about 2× apart. I modeled three newsroom units across YouTube, Instagram, Facebook, and X in layered dbt models with a 17-metric semantic layer, fixed Instagram views inflated 100× or more, then reconciled 13 legacy views row by row and replaced them in production with zero dashboard changes.',
  },
  {
    href: '/projects/metrics-layer/#orchestration',
    repo: 'https://github.com/shangweiyang79/taiwanplus-dbt/blob/main/.github/workflows/ci.yml',
    title: 'Event-driven orchestration and CI/CD',
    year: '2026',
    stack: 'Cloud Workflows · Pub/Sub · Eventarc · GitHub Actions',
    blurb:
      'Replaced fixed-time refreshes with a Pub/Sub, Eventarc, and Cloud Workflows chain, so new YouTube data lands about a day earlier. Every pull request to main must pass an isolated dbt build and all 40 tests before GitHub Actions deploys it, keyless through Workload Identity Federation.',
  },
  {
    title: 'Multi-platform performance pipeline',
    year: '2025',
    stack: 'Python · BigQuery · Cloud Run',
    blurb:
      "The team's first automated pipeline, loading YouTube, Meta, and X metrics into BigQuery on a schedule for the newsroom's dashboards and biweekly report. Monthly data prep fell from 2 hours to 30 minutes.",
  },
  {
    href: '/projects/youtube-intelligence/',
    repo: 'https://github.com/shangweiyang79/AI_project',
    title: 'Competitive-intelligence assistant',
    year: '2026',
    stack: 'Python · BigQuery · Vertex AI Search · Cloud Run',
    blurb:
      "I pitched and built a weekly pipeline that cleans and dedupes competitors' YouTube videos into a search index, powering a RAG chatbot that helps editors find on-brand video ideas and cut their decision time 30%.",
  },
];
---

<Base
  title="Data engineering — Shangwei Yang"
  description="Data engineering work by Shangwei (Joy) Yang: a tested dbt metrics layer, event-driven orchestration, CI/CD, and pipelines into BigQuery."
>
  <h1>Data engineering</h1>
  <p class="intro">
    Getting data in, making it trustworthy, and shipping changes safely, all at TaiwanPlus.
  </p>
  <TrackNav />

  <figure class="lead">
    <OrchestrationDiagram />
    <ul class="readout">
      <li><b>~1 day</b><span class="k">earlier YouTube data</span></li>
      <li><b>40</b><span class="k">dbt tests on every PR</span></li>
      <li><b>0</b><span class="k">stored keys</span></li>
    </ul>
    <figcaption>
      <span class="fig-no">Fig. 1</span>Fixed-time queries kept running before YouTube's reports
      landed. Now the transfer itself starts the chain, and the tables refresh only when the source
      is newer.
    </figcaption>
  </figure>

  <ProjectList projects={projects} />

  <p class="training">
    <span class="eyebrow">Training</span>
    Team capstone, TibaMe Data Engineering Program: scraped Taiwan box-office data and built an ETL
    pipeline with Prefect and a Tableau dashboard.
  </p>
</Base>

<style>
  .intro {
    color: var(--muted);
    margin-bottom: 0;
    max-width: var(--measure);
  }
  .lead {
    margin: 0 0 3rem;
  }
  .training {
    border-top: 1px solid var(--grid);
    color: var(--muted);
    font-size: 0.95rem;
    max-width: var(--measure);
    padding-top: 1.2rem;
  }
  .training .eyebrow {
    display: block;
    margin-bottom: 0.3rem;
  }
</style>
