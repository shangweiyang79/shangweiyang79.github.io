---
import Base from '../layouts/Base.astro';
import MetricsLayerDiagram from '../components/MetricsLayerDiagram.astro';
import RagDiagram from '../components/RagDiagram.astro';
---

<Base title="Shangwei Yang — Data Engineering">
  <section class="hero">
    <p class="eyebrow">Shangwei (Joy) Yang · data engineering · Taipei</p>
    <h1>I build the pipelines and tested metrics a newsroom reports from.</h1>
    <p class="lede">
      As a Data Analyst at TaiwanPlus, a newsroom with no data engineer on staff, I automated the
      pipelines and built a tested dbt semantic layer, so dashboards, reports, and our AI assistant
      share one set of metric definitions.
    </p>
    <p class="meta hero-stack">
      dbt · SQL · BigQuery · Python · Cloud Workflows · GitHub Actions · Cloud Run
    </p>
    <p class="hero-links">
      <a href="https://github.com/shangweiyang79">github</a>
      <a href="https://www.linkedin.com/in/shang-wei-yang-670b9091/">linkedin</a>
      <a href="mailto:shangweiyang79@gmail.com">email</a>
    </p>
  </section>

  <section class="work">
    <figure>
      <MetricsLayerDiagram />
      <ul class="readout">
        <li><b>17</b><span class="k">semantic metrics</span></li>
        <li><b>13</b><span class="k">legacy views replaced</span></li>
        <li><b>0</b><span class="k">dashboard changes</span></li>
        <li><b>40</b><span class="k">dbt tests</span></li>
      </ul>
      <figcaption>
        <span class="fig-no">Fig. 1</span>One metrics layer for three newsroom units on four social
        platforms. Dashboards, reports, forecasts, and an AI assistant read the same definitions.
      </figcaption>
    </figure>
    <p class="work-note">
      The dashboards stayed live throughout: every legacy view was rebuilt under its old name and
      reconciled row by row before the switch. The data team's AI assistant runs on the same
      semantic layer.
      <a href="/projects/metrics-layer/">Read the full story</a> or see the
      <a href="https://github.com/shangweiyang79/taiwanplus-dbt">code on GitHub</a>.
    </p>

    <figure>
      <RagDiagram />
      <ul class="readout">
        <li><b>~10</b><span class="k">channels tracked weekly</span></li>
        <li><b>−30%</b><span class="k">editors' decision time</span></li>
        <li><b>8</b><span class="k">checks on every answer</span></li>
      </ul>
      <figcaption>
        <span class="fig-no">Fig. 2</span>Competitive-intelligence assistant for the TaiwanPlus
        newsroom. A weekly pipeline cleans and dedupes competitors' YouTube videos, loads them into
        BigQuery, and keeps a search index in sync, so editors can ask what is working elsewhere.
      </figcaption>
    </figure>
    <p class="work-note">
      I pitched this and built it end to end on GCP: pipeline, warehouse, retrieval, generation,
      and deployment.
      <a href="/projects/youtube-intelligence/">Read the architecture</a> or see the
      <a href="https://github.com/shangweiyang79/AI_project">code on GitHub</a>.
    </p>
  </section>

  <p class="more">
    <a href="/projects/">All data engineering work</a>
    <a href="/projects/data-science/">Data science work</a>
  </p>
</Base>

<style>
  .hero {
    margin: 1.5rem 0 4rem;
  }
  .hero h1 {
    max-width: 46rem;
  }
  .lede {
    font-size: 1.18rem;
    line-height: 1.6;
    max-width: 40rem;
  }
  .hero-stack {
    margin: 1.4rem 0 0.6rem;
  }
  .hero-links,
  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .work figure {
    margin-top: 3.5rem;
  }
  .work-note {
    color: var(--muted);
    font-size: 0.95rem;
    margin-top: 0.9rem;
    max-width: var(--measure);
  }
  .more {
    border-top: 1px solid var(--grid);
    margin-top: 4rem;
    padding-top: 1.4rem;
  }
</style>
